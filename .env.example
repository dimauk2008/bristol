# ============================================================
# Бристоль — учётные данные для автономной работы (Railway/Prod)
# ADB и эмулятор НЕ нужны: достаточно refresh-токена.
# ============================================================

# Обязательно: refresh-токен приложения Бристоль (JWT).
# Берётся из bristol_prefs.xml (flutter.refreshToken) или из БД (bristol_meta.refresh_token).
BRISTOL_REFRESH_TOKEN=

# Опционально: текущий access-токен (если нет — будет получен из refresh).
BRISTOL_TOKEN=

# Опционально: external_id (guid пользователя). Если пусто — берётся из JWT токена.
BRISTOL_EXTERNAL_ID=

# Девайс, который подставляется в кодах карты. Реальный билд телефона.
BRISTOL_CARD_DEVICE_ID=SP1A.210812.016

# API-ключ приложения (есть в APK; менять не нужно).
BRISTOL_X_API_KEY=e3d7d5678cd42574ce055966496b02f3

# ============================================================
# Автообновление (не требует кнопки «Синхронизировать»)
# ============================================================

# 0 — выключить фоновое обновление токенов. По умолчанию включено.
BRISTOL_AUTO_REFRESH=1

# Как часто продлевать refresh-токен (минуты). Держит цепочку живой постоянно.
BRISTOL_KEEPALIVE_MIN=360

# Как часто синхронизировать купоны и коды карты (минуты). 0 — не синхронизировать.
BRISTOL_AUTO_SYNC_MIN=360

# 1 — при старте перезаписывать токены в БД значением BRISTOL_REFRESH_TOKEN.
# По умолчанию env НЕ перетирает уже сохранённые (ротированные) токены.
BRISTOL_ENV_TOKEN_OVERWRITE=0

# ============================================================
# Админка веб-панели
# ============================================================

# Пароль входа в админку. Если пусто — 'bristol' при первом запуске.
ADMIN_PASSWORD=bristol

# ============================================================
# Прочее
# ============================================================

# Путь к SQLite. По умолчанию — рядом с кодом (web_coupons/coupons.db).
# На Railway файловая система эфемерная: используйте Volume и укажите путь,
# либо оставьте пустым (БД будет создаваться заново при каждом деплое,
# купоны подтянутся из web_coupons/seed_coupons.json).
DB_PATH=

# --- PostgreSQL (продакшен) ---
# Если задан DATABASE_URL (postgres://...), приложение использует PostgreSQL,
# а DB_PATH игнорируется. Также поддерживаются POSTGRES_URL, POSTGRESQL_URL, DB_URL
# или стандартные переменные libpq (PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE).
# DATABASE_URL=postgresql://user:password@host:5432/dbname
